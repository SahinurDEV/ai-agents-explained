# Copy to .env and pick ONE option.

# Option A - offline, no key (mock model; good for learning the code paths)
LLM_PROVIDER=mock

# Option B - free & local with Ollama (https://ollama.com): `ollama pull llama3.1`
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1

# Option C - any OpenAI-compatible API (OpenAI, Groq, OpenRouter, ...)
# LLM_PROVIDER=openai
# LLM_API_KEY=your-key-here
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=            # leave empty for OpenAI, or set your provider's URL

# Embeddings for step 5: local (offline hashing) or openai
EMBED_PROVIDER=local
# EMBED_MODEL=text-embedding-3-small
